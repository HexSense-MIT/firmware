{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Clean & Rebuild",
            "type": "shell",
            "command": "rm -rf build/Debug && cmake --preset Debug && cmake --build build/Debug --parallel",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["absolute"]
            }
        },
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake --preset Debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "cmake --build build/Debug --parallel",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["absolute"]
            },
            "dependsOn": "CMake Configure"
        }
    ]
}
